table CollisionOverview
	lineageTag: 4ce7c1f1-8072-47fe-9a14-549f389e30df

	measure 'Total Collisions' = COUNTROWS('CollisionOverview')
		formatString: #,##0
		lineageTag: 80753a2c-df16-4800-ab27-444fb74a9a46

	measure 'Severe Collisions' = CALCULATE([Total Collisions], 'CollisionOverview'[Is Severe] = TRUE())
		formatString: #,##0
		lineageTag: 5758128c-7652-444a-94d9-f2f5683bdf25

	measure 'Severe Collision Rate' = DIVIDE([Severe Collisions], [Total Collisions])
		formatString: 0.0%
		lineageTag: 09b60244-42a2-408b-b4fc-0aebf5739fad

	measure 'People Injured' = SUM('CollisionOverview'[People Injured])
		formatString: #,##0
		lineageTag: 9130cbda-945c-4d0c-8821-6400b6132ec8

	measure 'People Killed' = SUM('CollisionOverview'[People Killed])
		formatString: #,##0
		lineageTag: e0194c11-3b5a-414f-8d99-e9a59e7814a9

	measure 'Pedestrians Injured' = SUM('CollisionOverview'[Pedestrians Injured])
		formatString: #,##0
		lineageTag: b7a46d71-68e8-4a44-abc0-adc9b10f5923

	measure 'Cyclists Injured' = SUM('CollisionOverview'[Cyclists Injured])
		formatString: #,##0
		lineageTag: b917bb20-4c7f-4895-966b-483a4a566639

	measure 'Avg Severity Score' = AVERAGE('CollisionOverview'[Severity Score])
		formatString: #,##0.00
		lineageTag: 7d0bbdce-ffd6-4c7c-bb41-508f62b66209

