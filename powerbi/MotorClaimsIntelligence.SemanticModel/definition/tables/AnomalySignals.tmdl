table AnomalySignals
	lineageTag: 0c779b94-0216-4019-98fb-75937935a5bc

	measure 'Review Collisions' = CALCULATE(COUNTROWS('AnomalySignals'), 'AnomalySignals'[Review Status] = "Review")
		formatString: #,##0
		lineageTag: 76086777-ff49-437e-9399-e7631efcec04

	measure 'Review Rate' = DIVIDE([Review Collisions], COUNTROWS('AnomalySignals'))
		formatString: 0.0%
		lineageTag: 877ddaa8-d217-4b3f-a132-fc0d0763426c

	measure 'Night Events' = CALCULATE(COUNTROWS('AnomalySignals'), 'AnomalySignals'[Is Night] = TRUE())
		formatString: #,##0
		lineageTag: ef413a9c-8656-4ffa-9057-8906dd172d4a

	measure 'Multi Vehicle Events' = CALCULATE(COUNTROWS('AnomalySignals'), 'AnomalySignals'[Vehicle Count] >= 3)
		formatString: #,##0
		lineageTag: 0d6acde9-4929-43d8-b607-6a38c95d7d1f

	column 'Collision ID'
		dataType: string
		lineageTag: 4dc14fa1-a1b0-49de-a701-9659aa173450
		summarizeBy: none
		sourceColumn: collision_key

		annotation SummarizationSetBy = Automatic

	column 'Crash Date'
