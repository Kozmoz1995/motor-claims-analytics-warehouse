	partition AnomalySignals = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(Server, Database),
				    Data = Source{[Schema="reporting",Item="rpt_fraud_signal_proxy"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
