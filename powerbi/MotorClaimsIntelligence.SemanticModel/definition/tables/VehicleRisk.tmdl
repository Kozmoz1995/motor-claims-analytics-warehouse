table VehicleRisk
	lineageTag: 9dc3778f-3c90-4590-b166-9b3b1bd48813

	measure 'Vehicle Involvements' = SUM('VehicleRisk'[Vehicle Involvements])
		formatString: #,##0
		lineageTag: d8959d96-7057-44d6-b278-ede3f1a85ce5

	measure 'Vehicle Severe Rate' = DIVIDE(SUM('VehicleRisk'[Severe Collisions]), SUM('VehicleRisk'[Collisions]))
		formatString: 0.0%
		lineageTag: 7d92159f-5e21-4b67-b51c-edc44bad2e81

	measure 'Avg Vehicle Severity' = AVERAGE('VehicleRisk'[Avg Severity Score])
		formatString: #,##0.00
		lineageTag: bd5e9cc4-e0da-4a6e-a719-85c6a26a67fd

	column 'Vehicle Type'
